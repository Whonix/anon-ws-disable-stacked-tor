#!/bin/bash

## Functions here are reached only indirectly -- through traps and the
## option dispatch -- which shellcheck cannot follow.
# shellcheck disable=SC2317

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

#### meta start
#### project Whonix
#### category networking
#### workstation_only yes
#### description
## <code>socat-unix-sockets</code> starter.
#### meta end

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## Provides variable $GATEWAY_IP so it can be used by `source`d config snippets.
## QUOTED. An earlier comment here claimed the word splitting was required --
## that eval would otherwise receive the whole block as one argument. Measured,
## that is FALSE: eval parses a single argument containing newlines as multiple
## commands, and every assignment lands. Unquoted, the substitution was also
## subject to PATHNAME EXPANSION, so a settings value containing a glob
## character could turn into filenames or an eval syntax error.
eval "$(/usr/libexec/helper-scripts/settings_echo)"

## Process configuration folders. Allows overwriting GATEWAY_IP.

shopt -s nullglob
for i in /etc/anon-ws-disable-stacked-tor.d/*.conf /rw/anon-ws-disable-stacked-tor.d/*.conf /usr/local/etc/anon-ws-disable-stacked-tor.d/*.conf; do
   bash_n_exit_code="0"
   bash_n_output="$(bash -n "${i}" 2>&1)" || { bash_n_exit_code="$?" ; true; };
   if [ ! "${bash_n_exit_code}" = "0" ]; then
      printf '%s\n' "Invalid config file: ${i}
bash_n_exit_code: ${bash_n_exit_code}
bash_n_output:
${bash_n_output}" >&2
      exit 1
   fi
   ## Dynamic path from the glob above; R-081 prescribes SC1090 here.
   # shellcheck disable=SC1090
   source "${i}"
done

## '|| true' in case no child process is run.
pid_list="$(pgrep -P "$$")" || true

if [ "${pid_list}" = "" ]; then
   printf '%s\n' "INFO: No processes launched into background, ok."
   exit 125
fi

## Relying on systemd KillMode=control-group to kill the child processes as
## well as this script.
## DELIBERATELY UNQUOTED: pgrep emits a NEWLINE-separated list of PIDs and
## 'wait' wants them as separate arguments. Quoted -- as a blanket shellcheck
## sweep does -- wait receives one string, treats it as a single invalid job
## spec and returns immediately, so this supervisor stops waiting for the
## socat children it is supposed to reap.
# shellcheck disable=SC2086
wait ${pid_list}
