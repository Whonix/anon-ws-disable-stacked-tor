#!/bin/bash

## Copyright (C) 2017 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

#### meta start
#### project Whonix
#### category networking
#### workstation_only yes
#### description
## <code>/usr/sbin/tor</code> simply executes <code>/usr/bin/tor</code>.
#### meta end

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## style-ok: allow-exec -- transparent wrapper: tor must BECOME this process
## so its exit code, signals and stdio are the real ones the caller sees.

exec /usr/bin/tor
